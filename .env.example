# Copy this file to .env and fill in your own values

# Django secret key (generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
SECRET_KEY=change-me

# True for local development, False for production
DEBUG=True

# Comma-separated, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://home:home@localhost:5432/home

# Used by createsuperuser --no-input (during deployment)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
