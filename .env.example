# Скопіюй цей файл у .env і заповни своїми значеннями

# Секретний ключ Django (згенерувати: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
SECRET_KEY=change-me

# True - локальна розробка, False - продакшн
DEBUG=True

# Через кому, без пробілів
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://home:home@localhost:5432/home

# Дані для createsuperuser --no-input (використовуються при деплої)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
